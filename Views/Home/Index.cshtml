@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer localizer;


@{
    ViewData["Title"] = localizer["Listado de tareas"];
}
<div class="text-center">
    <h1 class="display-4">@localizer["Mis tareas"]</h1>
    <button type="button" class="btn btn-primary mb-3" onclick="agregarNuevaTareaAlListado()">
        @localizer["Agregar nueva tarea"]
    </button>
</div>

<div id="contenedor-listado-tareas" class="text-center">
    <div id="reordenable" class="text-start" data-bind="foreach: tareas">
        <div name="tarea" class="border mb-2 p-2" style="cursor: pointer"
             data-bind="click: manejarClickTarea">
            <div data-bind="text: titulo, hidden: esNuevo" class="fw-bold">
            </div>

            <div name="pasos-resumen" data-bind="visible: pasosTotal() > 0">
                <span data-bind="text: pasosRealizados">
                </span>/<span data-bind="text: pasosTotal">
                </span>
                <span data-bind="text: porcentajeCompletado">

                </span>
            </div>

            <input type="text" name="titulo-tarea" autocomplete="off"
                   data-bind="value: titulo, visible: esNuevo,
                    attr: {'data-id': id},
                    event: {focusout: manejarFocusoutTituloTarea}" />

        </div>
    </div>

    <div data-bind="visible: cargando" class="spinner-border">
        <span class="visually-hidden">@localizer["Cargando..."]</span>
    </div>

    <div data-bind="visible: noHayTareas">
        @localizer["No hay tareas para mostrar."]
    </div>

</div>
<partial name="ModalEditarTarea" />

@section Scripts {


   <script>
        const urlPasos = "/api/pasos";
   </script>
   <script src="~/js/ArchivosAdjuntos/archivos-adjuntos.js" asp-append-version="true"></script>
   <script src="~/js/Pasos/OrdenarPasos.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/pasos.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/actualizarPaso.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/manejarClickBorrarPaso.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/manejarClickCheckboxPasos.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/manejarClickDescripcionPaso.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/manejarClickSalvarPaso.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/manejarClickCancelarPaso.js" asp-append-version="true"></script>
    <script src="~/js/Pasos/manejarClickAgregarPaso.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/BorrarTareas.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/editarTareas.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/mostrarTodaLaTarea.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/OrdenTareas.js" asp-append-version="true"></script>
    <script src="~/js/Utilidades.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/tareas.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/tareaListado.js" asp-append-version="true"></script>
    <script src="~/js/Tareas/manejarFocusoutTituloTarea.js" asp-append-version="true"></script>
}