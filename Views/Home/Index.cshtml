@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer localizer;


@{
    ViewData["Title"] = localizer["Listado de tareas"];
}
<div class="text-center">
    <h1 class="display-4">
        @localizer["Mis tareas"]
    </h1>
    <button type="button" class="btn btn-primary mb-3" onclick="agregarNuevaTareaAlListado()">
        @localizer["Agregar nueva tarea"]
    </button>
</div>

<div id="contenedor-listado-tareas" class="text-center">
    <div class="text-start" data-bind="foreach: tareas">
        <div name="tarea" class="border mb-2 p-2" style="cursor: pointer">
            <div data-bind="text: titulo, hidden: esNuevo" class="fw-bold">
            </div>
            <input type="text" class="form-text" name="titulo-tarea" autocomplete="off" 
            data-bind="value: titulo, visible: esNuevo, event: {focusout: manejarFocusoutTituloTarea}" />
        </div>
    </div>

    <div data-bind="visible: cargando" class="spinner-border">
        <span class="visually-hidden">@localizer["Cargando..."]</span>
    </div>

    <div data-bind="visible: noHayTareas">
        @localizer["No hay tareas para mostrar."]
    </div>
</div>


@section Scripts {
    <script src="~/js/Utilidades.js" asp-append-version="true"></script>
    <script src="~/js/tareas.js" asp-append-version="true"></script>
    <script src="~/js/tareaListado.js" asp-append-version="true"></script>
    <script src="~/js/manejarFocusoutTituloTarea.js" asp-append-version="true"></script>
}