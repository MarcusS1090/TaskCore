@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer localizer;


@{
    ViewBag.Title = localizer["Editar Tarea"];
}

<div class="modal fade" id="modal-editar-tarea" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-editar-tarea-titulo" data-bind="text: titulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-9">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="txtTituloCrearTarea" 
                            placeholder="@localizer["titulo"]"
                            autocomplete="off"
                            data-bind="value: titulo, event: {change: manejarCambioEditarTarea}" />
                            <label for="txtTituloCrearTarea">@localizer["Título de la tarea"]</label>
                        </div>
                        <div class="mb-3">
                            <label>@localizer["Descripción"]</label>
                            <textarea type="text" class="form-control" rows="4"
                                      data-bind="value: descripcion,  event: {change: manejarCambioEditarTarea}">

                            </textarea>
                        </div>
                        <div class="mb-3">
                            <partial name="_Pasos"/>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <button data-bind="{click: intentarBorrarTarea}"
                        class="btn btn-danger m-auto w-auto text-center">
                            <i class="bi bi-trash3"></i>
                            @localizer["Eliminar tarea"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>