@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer localizer;
@{
    ViewBag.Title = localizer["Pasos"];
}

<label><i class="bi bi-check-square"></i>@localizer["Pasos de la tarea"]</label>
<button class="btn btn-secondary btn-sm" onclick="manejarClickAgregarPaso()">
    <i class="bi bi-plus"></i>
</button>

<div data-bind="foreach: pasos">
    <div class="mt-2">
        <div class="row">
            <div class="col-1">
                <input type="checkbox" class="form-check-input" name="chbPaso" 
                       data-bind="{checked: realizado, click: manejarClickCheckboxPasos}" />
            </div>
            <div class="col-11">
                <span style="cursor:pointer"
                    data-bind="{text: descripcion, hidden: modoEdicion,
                    click: manejarClickDescripcionPaso,
                    css:{'text-decoration-line-through': realizado} }">
                </span>
                <textarea name="txtPasoDescripcion" class="form-control" 
                placeholder="@localizer["Agregue una descripción"]" 
                data-bind="{value: descripcion, visible: modoEdicion}">
                </textarea>

                <div class="mt-2" data-bind="{visible:modoEdicion}">
                    <button class="btn btn-success" type="button"
                    data-bind="{click: manejarClickSalvarPaso}">
                    @localizer["Guardar"]
                    </button>
                    <button class="btn btn-secondary" type="button"
                    data-bind="{click: manejarClickCancelarPaso}">
                        @localizer["Cancelar"]
                    </button>
                    <button class="btn btn-danger" type="button"
                    data-bind="{hidden: esNuevo, 
                    click: manejarClickBorrarPaso}">
                        @localizer["Borrar"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>