@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer localizer;

@model UsuariosListadoViewModel

@{
	ViewData["Title"] = "Listado de Usuarios";
	Layout = "../shared/_Layout";
}

<h1>@localizer["Listado de usuarios"]</h1>


@if (Model.Mensaje is not null)
{
	<div class="alert alert-danger">
		@Model.Mensaje
	</div>
}

@if (Model.Usuarios is not null)
{
	<form method="post">
		<table class="table table-hover">
			<thead>
				<tr>
					<td>@localizer["Acción"]</td>
					<td>@localizer["Email"]</td>
				</tr>
			</thead>
			<tbody>
				@foreach (var usuario in Model.Usuarios)
				{
					<tr>
						<td>
							<button class="btn btn-primary me-2 mb-2 mx-2" asp-action="HacerAdmin" asp-route-email="@usuario.Email">
                                @localizer["Hacer Administrador"]
							</button>
							<button class="btn btn-danger me-2 mb-2 mx-2" asp-action="RemoverAdmin" asp-route-email="@usuario.Email">
                                @localizer["Remover Administrador"]
							</button>
						</td>
						<td>
							@usuario.Email
						</td>
					</tr>
				}
			</tbody>
		</table>
	</form>
} else 
{
	<div class="alert alert-info">
        @localizer["No hay usuarios registrados."]
	</div>
}